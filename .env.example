# Current market-data providers use public endpoints and require no API key.
# Keep future exchange or notification credentials server-side only.
BINANCE_BASE_URL=https://fapi.binance.com
OKX_BASE_URL=https://www.okx.com

# Optional: Telegram alerts (server-side only). Without both, Telegram stays "尚未設定".
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: external cron can POST /api/alerts/evaluate with a market snapshot
# for 24/7 evaluation (page-open evaluation alone is not 24/7).
